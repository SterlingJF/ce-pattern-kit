{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src/**/*.ts", "src/**/*.mjs", "tools/**/*.ts", "tools/**/*.mjs"],
  "exclude": [
    "src/assets/tools/ce-pattern/test-fixtures",
    "src/assets/presets/**/*.ts",
    "src/assets/presets/**/*.tsx",
    "examples",
    "node_modules"
  ]
}
