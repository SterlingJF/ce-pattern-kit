{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:all"],
  "osvVulnerabilityAlerts": true,
  "minimumReleaseAge": "14 days",
  "rangeStrategy": "pin",
  "timezone": "America/New_York",
  "schedule": ["* 12 * * 1"],
  "automergeSchedule": ["* 12 * * 1"],
  "lockFileMaintenance": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies", "dev"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ],
  "vulnerabilityAlerts": {
    "groupName": "all dependencies",
    "schedule": ["* 12 * * 1"],
    "automerge": true
  },
  "ignorePaths": ["skills/**"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^src/assets/versions\\.json$/"],
      "matchStrings": [
        "\"(?<depName>[^\"]+)\": \"(?<currentValue>\\d[^\"]+)\""
      ],
      "datasourceTemplate": "npm"
    }
  ]
}
